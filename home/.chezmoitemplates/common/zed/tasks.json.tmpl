[
  {
    "label": "Onefetch",
    "command": "onefetch",
    "user_new_terminal": true,
    "allow_concurrent_runs": true,
    "reveal": "always",
    "reveal_target": "center",
    "hide": "never",
    "shell": "system",
    "show_summary": false,
    "show_command": false
  },
  {
    "label": "Open in Ghostty",
    "command": "ghostty --working-directory=$ZED_WORKTREE_ROOT"
  },
  {
    "label": "chezmoi apply",
    "command": "chezmoi",
    "args": ["apply", "--verbose"],
    "reveal": "never"
  },
  {
    "label": "tv:text_finder",
    "command": "zed $(tv text)",
    "hide": "always",
    "user_new_terminal": true,
    "shell": {
      "with_arguments": {
        "program": "sh",
        "args": ["--noediting", "--norc", "--noprofile"]
      }
    }
  },
  {
    "label": "tv:find_text_in_files",
    "command": "zed $(tv --input '${ZED_SELECTED_TEXT:-}' --exact text)",
    "hide": "always",
    "allow_concurrent_runs": true,
    "use_new_terminal": true,
    "shell": {
      "with_arguments": {
        "program": "sh",
        "args": ["--noediting", "--norc", "--noprofile"]
      }
    }
  },
  {
    "label": "Oil",
    "command": "exec nvim --cmd \"set noswapfile\" -c \"lua require('oil').open_float('$ZED_DIRNAME')\" -c \"autocmd FileType oil nnoremap <buffer>silent> q :qa!<CR>\"",
    "user_new_terminal": true,
    "target": "center",
    "hide": "always"
  }
]
