[metadata]
name         = "gh-issues"
description  = "List GitHub issues for the current repo"
requirements = ["gh", "jq"]

[source]
ansi   = true
output = "{strip_ansi|split:\t:..}"

  [[source.command]]
  name = "  My Issues"
  run  = """
    gh issue list --search "is:open involves:@me" --limit 50 --json number,title,author,labels,comments,createdAt,updatedAt |
    jq -r '.[] | ["\\u001b[1;36m#\\(.number)\\u001b[0m", "\\u001b[34m\\(.author.name)\\u001b[0m", "\\(.title)", "\\u001b[31m  \\(.comments | length)\\u001b[0m", ([.labels[] | .name] | join(","))] | @tsv' |
    column -t -s (printf '\t')
  """

  [[source.command]]
  name = "  Assigned"
  run  = """
    gh issue list --search "is:open assignees:@me" --limit 50 --json number,title,author,labels,comments,createdAt,updatedAt |
    jq -r '.[] | ["\\u001b[1;36m#\\(.number)\\u001b[0m", "\\u001b[34m\\(.author.name)\\u001b[0m", "\\(.title)", "\\u001b[31m  \\(.comments | length)\\u001b[0m", ([.labels[] | .name] | join(","))] | @tsv' |
    column -t -s (printf '\t')
  """

  [[source.command]]
  name = "  Closed"
  run  = """
    gh issue list --search "is:closed involves:@me" --limit 50 --json number,title,author,labels,comments,createdAt,updatedAt |
    jq -r '.[] | ["\\u001b[1;36m#\\(.number)\\u001b[0m", "\\u001b[34m\\(.author.name)\\u001b[0m", "\\(.title)", "\\u001b[31m  \\(.comments | length)\\u001b[0m", ([.labels[] | .name] | join(","))] | @tsv' |
    column -t -s (printf '\t')
  """

[ui]
layout = "landscape"

  [ui.input_bar]
  position = "top"
  prompt   = "  "

  [ui.preview_panel]
  header = "#{strip_ansi|split:#:1|split: :0}"
  footer = "⌃ + o: Open browser | ⌃ + y: yank URL"

[preview]
command = """
gh issue view '{strip_ansi|split:#:1|split: :0}' --repo '{strip_ansi|split: :1}' --json number,title,body,state,author,createdAt,updatedAt,labels,assignees |
jq -r '
"\\u001b[33m" + .title + "\\u001b[0m\\n\\n" + "\u001b[36mStatus:\u001b[39m \\u001b[32m" + .state + "\\u001b[39m\\n",
"  \\u001b[36mAuthor:\\u001b[39m \\u001b[33m" + .author.login + "\\u001b[39m\\n",
"  \\u001b[36mCreated:\\u001b[39m " + (.createdAt | fromdateiso8601 | (now - .) | if . < 3600 then (./60|floor|tostring) + " minutes ago" elif . < 86400 then (./3600|floor|tostring) + " hours ago" else (./86400|floor|tostring) + " days ago" end),
"  \\u001b[36mUpdated:\\u001b[39m " + (.updatedAt | fromdateiso8601 | (now - .) | if . < 3600 then (./60|floor|tostring) + " minutes ago" elif . < 86400 then (./3600|floor|tostring) + " hours ago" else (./86400|floor|tostring) + " days ago" end),
(if (.labels | length) > 0 then "  \\u001b[36mLabels:\\u001b[39m " + ([.labels[] | "\\u001b[35m" + .name + "\\u001b[39m"] | join(" ")) else "" end),
(if (.assignees | length) > 0 then "  \\u001b[36mAssignees:\\u001b[39m " + ([.assignees[].login] | join(", ")) else "" end),
"" +
"  \\u001b[90m────────────────────────────────────────────────────────────\\u001b[39m",
"",
(.body // "")
'
"""

[keybindings]
ctrl-o = "actions:open"
ctrl-d = "actions:close"
ctrl-y = "actions:yank"

[actions.open]
description = "Open the issue in the browser"
command     = "gh issue view {strip_ansi|split:#:1|split: :0} --repo '{strip_ansi|split: :1}' --web"
mode        = "fork"

[actions.yank]
description = "Copy issue URL to clipboard"
command     = "gh issue view {strip_ansi|split:#:1|split: :0} --json url | jq '.url' | {{ .cmd.copy }}"
mode        = "fork"

[actions.close]
description = "Close the selected issue"
command     = "gh issue close {strip_ansi|split:#:1|split: :0} --repo '{strip_ansi|split: :1}'"
mode        = "fork"

[actions.comment]
description = "Add a comment to the selected issue"
command     = "gh issue comment {strip_ansi|split:#:1|split: :0} --repo '{strip_ansi|split: :1}'"
mode        = "execute"
