{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":semanticCommits",
    ":disableDependencyDashboard",
    ":separateMultipleMajorReleases",
    "helpers:pinGitHubActionDigests"
  ],

  "timezone": "Asia/Tokyo",
  "prHourlyLimit": 5,
  "prConcurrentLimit": 10,
  "assigneesFromCodeOwners": true,
  "minimumReleaseAge": "3 days",
  "vulnerabilityAlerts": { "enabled": true },
  "labels": ["CI/CD 🔁", "Deps 📦️"],

  "enabledManagers": ["github-actions", "mise", "apm", "custom.regex"],
  "packageRules": [
    {
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "minimumReleaseAge": "7 days"
    },
    {
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true
    },
    {
      "groupName": "GitHub Actions",
      "description": "Group GitHub Actions updates",
      "matchManagers": ["actions/checkout", "actions/labeler"],
      "addLabels": ["CI/CD 🔁"]
    },
    {
      "groupName": "mise",
      "description": "Group mise tools updates",
      "matchPackageNames": ["jdx/mise"],
      "addLabels": ["mise ⚙️"]
    },
    {
      "groupName": "Security",
      "matchPackageNames": ["zizmorcore/zizmor-action"],
      "addLabels": ["Security 🛡️"]
    },
    {
      "groupName": "chezmoi",
      "description": "Group chezmoi updates",
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["home/\\.chezmoiversion$", "home/\\.chezmoiexternals/*\\.toml\\.tmpl$"],
      "addLabels": ["chezmoi 🏘️"]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": ["Update mise tool versions in the linter workflow"],
      "managerFilePatterns": ["^\\.github/workflows/linter\\.yml$"],
      "matchStrings": ["\"aqua:(?<depName>[^\"/]+/[^\"/]+)(?:/[^\"]+)?\"\\s*=\\s*\"(?<currentValue>[^\"]+)\""],
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": ["Update Chezmoi version"],
      "managerFilePatterns": ["home/\\.chezmoiversion$"],
      "matchStrings": ["^(?<currentValue>.*)\\s$"],
      "depNameTemplate": "twpayne/chezmoi",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$",
      "versioningTemplate": "semver"
    }
  ],
  "mise": {
    "managerFilePatterns": ["home/dot_config/mise/config.toml.tmpl", "mise.toml"],
    "pinDigests": false
  }
}
