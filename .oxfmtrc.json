{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/refs/heads/main/npm/oxfmt/configuration_schema.json",
  "ignorePatterns": [
    "**/*.md",
    "**/*.toml",
    ".agents/skills/**",
    "docs/**",
    "karabiner/karabiner.json",
    "raycast/snippets/*.json",
  ],
  "trailingComma": "all",
  "arrowParens": "always"
}
