{
  "$schema": "https://opencode.ai/config.json",
  "compaction": {
    "auto": true,
    "prune": true
  },
  "watcher": {
    "ignore": [
      ".git/**",
      "**/*.log",
      ".rumdl_cache",
      "node_modules/**",
      "dist/**",
      ".claude",
      ".codex",
      ".antigravitycli",
      ".opencode"
    ]
  },
  "instructions": ["AGENTS.md"],
  "default_agent": "build",
  "agent": {
    "plan": { "disable": true },
    "build": {
      "disable": false,
      "permissions": [
        { "action": "memory_*", "resource": "*", "effect": "allow" },
        { "action": "context7_*", "resource": "*", "effect": "allow" },
        { "action": "gh_grep_*", "resource": "*", "effect": "allow" }
      ]
    },
    "general": {
      "disable": false,
      "permissions": [
        { "action": "memory_*", "resource": "*", "effect": "allow" },
        { "action": "context7_*", "resource": "*", "effect": "allow" },
        { "action": "gh_grep_*", "resource": "*", "effect": "allow" }
      ]
    },
    "explore": {
      "disable": false,
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "gh_grep_*", "resource": "*", "effect": "allow" }
      ]
    },
    "scout": {
      "disable": true
    },
    "auditor": {
      "disable": false,
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "gh_grep_*", "resource": "*", "effect": "allow" }
      ]
    },
    "translator": {
      "disable": false
    }
  }
}
